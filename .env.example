# Copy to .env for local development. Never commit .env itself.
# SQLite alternative: DATABASE_URL=sqlite:///C:/Users/HP/dev/javari-test.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Secret path token for inbound webhooks: POST /api/webhooks/<source>/<token>
# Also verifies GitHub deliveries (X-Hub-Signature-256). Empty disables the receiver.
WEBHOOK_SECRET=
# Optional canonical origin used for the webhook URL shown in the super-admin console.
# PUBLIC_BASE_URL=https://javari-server.onrender.com
# FLASK_DEBUG=1
# FRONTEND_ORIGINS=https://your-frontend.example.com
